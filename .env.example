# ==============================================================================
# REALITY CORP: ENVIRONMENT TEMPLATE (KEINE ECHTEN SECRETS EINTRAGEN!)
# Kopiere diese Datei lokal nach ".env.local" (wird durch .gitignore blockiert).
# ==============================================================================

# --- Client (Öffentliche Variablen für apps/game-client) ---
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-public-supabase-anon-key
PUBLIC_API_BASE_URL=http://localhost:3001/v1

# --- Backend (NUR Server-Umgebung in apps/backend - NIEMALS im Browser!) ---
PORT=3001
NODE_ENV=development
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-public-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-secret-service-role-key-server-only
DATABASE_POOLER_URL=postgresql://postgres.your-ref:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
CORS_ORIGIN=http://localhost:5173

