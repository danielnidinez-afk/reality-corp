# Supply-Chain-Härtung für pnpm / npm
# Deaktiviert automatische Lifecycle-Skripte (preinstall/postinstall) fremder Pakete;
# vertrauenswürdige Build-Skripte (z.B. esbuild, sharp) müssen in pnpm-workspace.yaml explizit über onlyBuiltDependencies freigegeben werden.
ignore-scripts=true
save-exact=true
engine-strict=true

