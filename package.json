{
  "name": "reality-corp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "check": "pnpm -r --if-present check",
    "lint": "eslint . && pnpm -r --if-present lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @reality-corp/game-client test:e2e",
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --filter @reality-corp/game-client dev",
    "dev:backend": "pnpm --filter @reality-corp/backend dev"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.0",
    "eslint": "10.14.0",
    "eslint-plugin-svelte": "3.24.1",
    "svelte": "5.57.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}

